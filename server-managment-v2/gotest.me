package database

import (
	"gorm.io/gorm"
	"yourapp/models"
)

func RunMigrations(db *gorm.DB) error {
	// Auto migrate models
	if err := db.AutoMigrate(&models.Customer{}, &models.Service{}); err != nil {
		return err
	}
	return nil
}

