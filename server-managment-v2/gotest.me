package models

import (
	"database/sql"
	"time"
)

type Service struct {
	ID                      uint            `gorm:"primaryKey" json:"id"`
	Name                    string          `gorm:"not null" json:"name"`
	Description             string          `json:"description"`
	CustomerID              uint            `gorm:"not null;index" json:"customer_id"`
	ServiceType             string          `gorm:"not null" json:"service_type"` // VPS, Dedicated Server, SSL Certificate, Domain, etc.
	ServiceSubType          string          `json:"service_sub_type"` // single service or managed service
	Datacenter              string          `gorm:"not null" json:"datacenter"`
	ProjectName             string          `json:"project_name"`
	Status                  string          `gorm:"default:'PROVISIONING'" json:"status"` // PROVISIONING, ACTIVE, SUSPENDED, EXPIRED
	
	// VPS Fields
	VpsCpu                  sql.NullInt64   `json:"vps_cpu"`
	VpsRamMb                sql.NullInt64   `json:"vps_ram_mb"`
	VpsDiskGb               sql.NullInt64   `json:"vps_disk_gb"`
	VpsOs                   sql.NullString  `json:"vps_os"`
	
	// SSL Certificate Fields
	SslType                 sql.NullString  `json:"ssl_type"`
	SslIssuer               sql.NullString  `json:"ssl_issuer"`
	SslExpiryDate           *time.Time      `json:"ssl_expiry_date"`
	
	// Domain Fields
	DomainName              sql.NullString  `json:"domain_name"`
	DomainRegistrar         sql.NullString  `json:"domain_registrar"`
	DomainExpiryDate        *time.Time      `json:"domain_expiry_date"`
	
	// Dedicated Server Fields
	DedicatedProcessor      sql.NullString  `json:"dedicated_processor"`
	DedicatedRamMb          sql.NullInt64   `json:"dedicated_ram_mb"`
	DedicatedDiskGb         sql.NullInt64   `json:"dedicated_disk_gb"`
	
	// Email Fields
	EmailAccounts           sql.NullInt64   `json:"email_accounts"`
	EmailStorageGb          sql.NullInt64   `json:"email_storage_gb"`
	
	// Shared Hosting Fields
	SharedDiskGb            sql.NullInt64   `json:"shared_disk_gb"`
	SharedBandwidthGb       sql.NullInt64   `json:"shared_bandwidth_gb"`
	
	// Backup as a Service Fields
	BackupFrequency         sql.NullString  `json:"backup_frequency"`
	BackupRetentionDays     sql.NullInt64   `json:"backup_retention_days"`
	
	// Endpoint Security Fields
	EndpointLicenseCount    sql.NullInt64   `json:"endpoint_license_count"`
	EndpointProtectionType  sql.NullString  `json:"endpoint_protection_type"`
	
	CreatedAt               time.Time       `json:"created_at"`
	UpdatedAt               time.Time       `json:"updated_at"`
}

type ServiceResponse struct {
	ID                      uint            `json:"id"`
	Name                    string          `json:"name"`
	Description             string          `json:"description"`
	CustomerID              uint            `json:"customer_id"`
	Customer                *Customer       `json:"customer,omitempty"`
	ServiceType             string          `json:"service_type"`
	ServiceSubType          string          `json:"service_sub_type"`
	Datacenter              string          `json:"datacenter"`
	ProjectName             string          `json:"project_name"`
	Status                  string          `json:"status"`
	VpsCpu                  *int64          `json:"vps_cpu,omitempty"`
	VpsRamMb                *int64          `json:"vps_ram_mb,omitempty"`
	VpsDiskGb               *int64          `json:"vps_disk_gb,omitempty"`
	VpsOs                   *string         `json:"vps_os,omitempty"`
	SslType                 *string         `json:"ssl_type,omitempty"`
	SslIssuer               *string         `json:"ssl_issuer,omitempty"`
	SslExpiryDate           *time.Time      `json:"ssl_expiry_date,omitempty"`
	DomainName              *string         `json:"domain_name,omitempty"`
	DomainRegistrar         *string         `json:"domain_registrar,omitempty"`
	DomainExpiryDate        *time.Time      `json:"domain_expiry_date,omitempty"`
	DedicatedProcessor      *string         `json:"dedicated_processor,omitempty"`
	DedicatedRamMb          *int64          `json:"dedicated_ram_mb,omitempty"`
	DedicatedDiskGb         *int64          `json:"dedicated_disk_gb,omitempty"`
	EmailAccounts           *int64          `json:"email_accounts,omitempty"`
	EmailStorageGb          *int64          `json:"email_storage_gb,omitempty"`
	SharedDiskGb            *int64          `json:"shared_disk_gb,omitempty"`
	SharedBandwidthGb       *int64          `json:"shared_bandwidth_gb,omitempty"`
	BackupFrequency         *string         `json:"backup_frequency,omitempty"`
	BackupRetentionDays     *int64          `json:"backup_retention_days,omitempty"`
	EndpointLicenseCount    *int64          `json:"endpoint_license_count,omitempty"`
	EndpointProtectionType  *string         `json:"endpoint_protection_type,omitempty"`
	CreatedAt               time.Time       `json:"created_at"`
	UpdatedAt               time.Time       `json:"updated_at"`
}

type Customer struct {
	ID                      uint            `gorm:"primaryKey" json:"id"`
	Name                    string          `json:"name"`
	Email                   string          `json:"email"`
	Phone                   string          `json:"phone"`
	CreatedAt               time.Time       `json:"created_at"`
	UpdatedAt               time.Time       `json:"updated_at"`
}

