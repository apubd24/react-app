package handlers

// GetCustomers - Get all customers (for dropdown)
// @Summary Get all customers
// @Description Get list of customers for dropdown selection
// @Router /api/customers [get]
func (h *ServiceHandler) GetCustomers(c *gin.Context) {
	var customers []models.Customer

	if err := h.DB.Select("id", "name").Find(&customers).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch customers"})
		return
	}

	c.JSON(http.StatusOK, customers)
}

