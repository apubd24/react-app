package routes

import (
	"github.com/gin-gonic/gin"
	"gorm.io/gorm"
	"yourapp/handlers"
)

func SetupRoutes(router *gin.Engine, db *gorm.DB) {
	h := &handlers.ServiceHandler{DB: db}

	// Services routes
	services := router.Group("/api/services")
	{
		services.GET("", h.GetServices)           // List services with filters
		services.POST("", h.CreateService)        // Create service
		services.GET("/:id", h.GetServiceByID)    // Get service by ID
		services.PUT("/:id", h.UpdateService)     // Update service
		services.DELETE("/:id", h.DeleteService)  // Delete service
	}

	// Customers routes
	customers := router.Group("/api/customers")
	{
		customers.GET("", h.GetCustomers)  // Get all customers
	}
}

