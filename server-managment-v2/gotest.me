package handlers

import (
	"errors"
	"net/http"
	"strconv"
	"github.com/gin-gonic/gin"
	"gorm.io/gorm"
	"yourapp/models"
)

type ServiceHandler struct {
	DB *gorm.DB
}

// GetServices - Get all services with filters and pagination
// @Summary Get all services
// @Description Get services with filtering, pagination, and sorting
// @Param search query string false "Search by name or description"
// @Param service_type query string false "Filter by service type"
// @Param status query string false "Filter by status"
// @Param customer_id query uint false "Filter by customer"
// @Param page query int false "Page number" default(1)
// @Param page_size query int false "Page size" default(10)
// @Router /api/services [get]
func (h *ServiceHandler) GetServices(c *gin.Context) {
	var services []models.Service
	var total int64

	query := h.DB

	// Search filter
	if search := c.Query("search"); search != "" {
		query = query.Where("name ILIKE ? OR description ILIKE ?", "%"+search+"%", "%"+search+"%")
	}

	// Service type filter
	if serviceType := c.Query("service_type"); serviceType != "" {
		query = query.Where("service_type = ?", serviceType)
	}

	// Status filter
	if status := c.Query("status"); status != "" {
		query = query.Where("status = ?", status)
	}

	// Customer filter
	if customerID := c.Query("customer_id"); customerID != "" {
		query = query.Where("customer_id = ?", customerID)
	}

	// Count total
	query.Model(&models.Service{}).Count(&total)

	// Pagination
	page := 1
	pageSize := 10
	if p := c.Query("page"); p != "" {
		if parsedPage, err := strconv.Atoi(p); err == nil && parsedPage > 0 {
			page = parsedPage
		}
	}
	if ps := c.Query("page_size"); ps != "" {
		if parsedSize, err := strconv.Atoi(ps); err == nil && parsedSize > 0 {
			pageSize = parsedSize
		}
	}

	offset := (page - 1) * pageSize
	if err := query.Offset(offset).Limit(pageSize).Order("created_at DESC").Find(&services).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch services"})
		return
	}

	// Load customer data for each service
	for i := range services {
		var customer models.Customer
		h.DB.Model(&customer).Where("id = ?", services[i].CustomerID).First(&customer)
		// Populate in response
	}

	c.JSON(http.StatusOK, gin.H{
		"data":  services,
		"total": total,
		"page":  page,
		"pages": (total + int64(pageSize) - 1) / int64(pageSize),
	})
}

// CreateService - Create a new service
// @Summary Create a new service
// @Description Create a service with type-specific fields
// @Accept json
// @Produce json
// @Param service body models.Service true "Service data"
// @Router /api/services [post]
func (h *ServiceHandler) CreateService(c *gin.Context) {
	var service models.Service
	if err := c.ShouldBindJSON(&service); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	// Validate required fields
	if service.Name == "" || service.CustomerID == 0 || service.Datacenter == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Missing required fields: name, customer_id, datacenter"})
		return
	}

	if err := h.DB.Create(&service).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create service"})
		return
	}

	c.JSON(http.StatusCreated, service)
}

// GetServiceByID - Get a service by ID
// @Summary Get service by ID
// @Description Get service details by ID
// @Param id path uint true "Service ID"
// @Router /api/services/{id} [get]
func (h *ServiceHandler) GetServiceByID(c *gin.Context) {
	id := c.Param("id")
	var service models.Service

	if err := h.DB.Where("id = ?", id).First(&service).Error; err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			c.JSON(http.StatusNotFound, gin.H{"error": "Service not found"})
		} else {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch service"})
		}
		return
	}

	c.JSON(http.StatusOK, service)
}

// UpdateService - Update a service
// @Summary Update a service
// @Description Update service details
// @Param id path uint true "Service ID"
// @Accept json
// @Produce json
// @Param service body models.Service true "Updated service data"
// @Router /api/services/{id} [put]
func (h *ServiceHandler) UpdateService(c *gin.Context) {
	id := c.Param("id")
	var service models.Service

	if err := h.DB.Where("id = ?", id).First(&service).Error; err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			c.JSON(http.StatusNotFound, gin.H{"error": "Service not found"})
		} else {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch service"})
		}
		return
	}

	var updateData models.Service
	if err := c.ShouldBindJSON(&updateData); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	if err := h.DB.Model(&service).Updates(updateData).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to update service"})
		return
	}

	c.JSON(http.StatusOK, service)
}

// DeleteService - Delete a service
// @Summary Delete a service
// @Description Delete a service by ID
// @Param id path uint true "Service ID"
// @Router /api/services/{id} [delete]
func (h *ServiceHandler) DeleteService(c *gin.Context) {
	id := c.Param("id")

	if err := h.DB.Where("id = ?", id).Delete(&models.Service{}).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to delete service"})
		return
	}

	c.JSON(http.StatusOK, gin.H{"message": "Service deleted successfully"})
}

