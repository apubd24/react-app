                          </span>
                        )}
                      </div>
                    </td>
                    
                    <td className="p-4 text-gray-600 font-medium">
                      <div>{s.project || "—"}</div>
                    </td>
                    
                    <td className="p-4">
                      <div className="flex flex-col gap-0.5 font-mono text-[11px] text-gray-500">
                        {s.ip ? (
                          <span className="flex items-center gap-1 text-gray-900 font-medium">
                            <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block shrink-0 print:hidden"></span>
                            Pri: {s.ip} {s.primaryvlan ? `(VLAN: ${s.primaryvlan})` : "(VLAN)"}
                          </span>
                        ) : (
                          <span className="text-gray-400">Pri: —</span>
                        )}
                        {s.secondaryip ? (
                          <span className="flex items-center gap-1 text-gray-500">
                            <span className="w-1.5 h-1.5 rounded-full bg-blue-400 inline-block shrink-0 print:hidden"></span>
                            Sec: {s.secondaryip} {s.secondaryvlan ? `(VLAN: ${s.secondaryvlan})` : "(VLAN)"}
                          </span>
                        ) : (
                          <span className="text-gray-300">Sec: —</span>
                        )}
                      </div>
                    </td>

                    <td className="p-4">
                      <div className="flex flex-col gap-1 items-start">
                        <span className={`inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold border ${getStatusBadgeClass(s.status)}`}>
                          {s.status}
                        </span>
                        {s.status === "POC" && s.pocExpiryDate && (
                          <span className="text-[10px] text-indigo-700 bg-indigo-50 border border-indigo-100 rounded px-1 flex items-center gap-0.5 font-medium">
                            Exp: {s.pocExpiryDate}
                          </span>
                        )}
                        {s.status === "Temporarily disabled" && s.temporarilydisabledDate && (
                          <span className="text-[10px] text-zinc-700 bg-zinc-50 border border-zinc-200 rounded px-1 flex items-center gap-0.5 font-medium">
                            Dis: {s.temporarilydisabledDate}
                          </span>
                        )}
                      </div>
                    </td>

                    {/* CONSOLIDATED DATE TIMELINE COLUMN */}
                    <td className="p-4">
                      <div className="flex flex-col gap-0.5 text-xs">
                        <div className="text-gray-900">
                          <span className="text-[10px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-100 rounded px-1 py-0.25 mr-1 font-sans">ACT</span>
                          <span className="font-mono text-gray-600">{s.activationDate || "—"}</span>
                        </div>
                        {s.discontinueDate && (
                          <div className="text-gray-900 mt-0.5 group relative">
                            <span className="text-[10px] font-bold text-rose-600 bg-rose-50 border border-rose-100 rounded px-1 py-0.25 mr-1 font-sans">DIS</span>
                            <span className="font-mono text-rose-600 font-medium">{s.discontinueDate}</span>
                            {s.discontinueReason && (
                              <div className="text-[10px] text-gray-400 italic font-normal block truncate max-w-[140px]" title={s.discontinueReason}>
                                {s.discontinueReason}
                              </div>
                            )}
                          </div>
                        )}
                      </div>
                    </td>

                    <td className="p-4">
                      <div className="text-gray-900 font-semibold text-xs tracking-tight">{s.cluster || "—"}</div>
                    </td>

                    <td className="p-4">
                      <div className="text-gray-900 font-semibold text-xs tracking-tight">{s.datacenter || "—"}</div>
                    </td>

                    <td className="p-4 print:hidden">
                      <div className="flex items-center justify-end gap-1.5">
                        <button 
                          title="View Details"
                          className="p-1.5 text-gray-500 hover:text-gray-900 border border-transparent hover:border-gray-200 hover:bg-white rounded-md transition-all"
                        >
                          <Eye size={15} />
                        </button>
                        <button
                          title="Edit Service"
                          onClick={() => openEdit(s)}
                          className="p-1.5 text-amber-600 hover:text-amber-700 border border-transparent hover:border-amber-200 hover:bg-amber-50 rounded-md transition-all"
                        >
                          <Edit size={15} />
                        </button>
                        <button
                          title="Delete Service"
                          onClick={() => deleteService(s.id)}
                          className="p-1.5 text-rose-600 hover:text-rose-700 border border-transparent hover:border-rose-200 hover:bg-rose-50 rounded-md transition-all"
                        >
                          <Trash2 size={15} />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colSpan="9" className="p-8 text-center text-gray-400 bg-gray-50/30">
                    No infrastructure records matched your search parameters or date range window.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>

        {/* PAGINATION MATRIX SECTION */}
        <div className="px-4 py-3 border-t border-gray-100 flex items-center justify-between bg-white select-none print:hidden">
          <div className="text-xs text-gray-500">
            Showing Page <span className="font-semibold text-gray-700">{page}</span> of <span className="font-semibold text-gray-700">{totalPages}</span>
          </div>
          <div className="flex items-center gap-1">
            <button
              onClick={() => setPage((p) => Math.max(p - 1, 1))}
              disabled={page === 1}
              className="p-1.5 text-gray-500 border rounded-md bg-white hover:bg-gray-50 disabled:opacity-40 disabled:hover:bg-white transition-colors"
            >
              <ChevronLeft size={15} />
            </button>
            <button
              onClick={() => setPage((p) => Math.min(p + 1, totalPages))}
              disabled={page === totalPages}
              className="p-1.5 text-gray-500 border rounded-md bg-white hover:bg-gray-50 disabled:opacity-40 disabled:hover:bg-white transition-colors"
            >
              <ChevronRight size={15} />
            </button>
          </div>
        </div>
      </div>

      {/* SYSTEM PROVISIONING CONTAINER MODAL */}
      {modalOpen && (
        <div className="fixed inset-0 bg-gray-900/40 backdrop-blur-xs flex items-center justify-center z-50 p-4 animate-fade-in print:hidden">
          <div className="bg-white rounded-xl shadow-xl w-full max-w-2xl border border-gray-100 flex flex-col max-h-[90vh] overflow-hidden transform scale-100 transition-all">
            
            {/* MODAL CONFIG HEADER */}
            <div className="flex items-center justify-between border-b border-gray-100 p-4 bg-gray-50/50">
              <div className="flex items-center gap-2.5">
                <div className="bg-blue-50 p-2 rounded-lg text-blue-600 border border-blue-100">
                  <Server size={18} />
                </div>
                <div>
                  <h2 className="text-base font-bold text-gray-900">
                    {editing ? "Edit Configuration" : "Provision New Service"}
                  </h2>
                  <p className="text-xs text-gray-500">
                    Modify profile characteristics and infrastructure properties.
                  </p>
                </div>
              </div>
              <button
                onClick={() => setModalOpen(false)}
                className="p-1 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-md transition-colors"
              >
                <X size={18} />
              </button>
            </div>

            {/* MODAL CONFIG CONTENT SCRIPTMASK */}
            <div className="p-5 overflow-y-auto space-y-4 flex-1">
              
              <div className="text-xs font-bold text-gray-400 uppercase tracking-wider flex items-center gap-1.5 border-b border-gray-200/60 pb-2">
                <FileText size={14} /> Global Configuration Metrics
              </div>

              <div className="grid sm:grid-cols-2 gap-4">
                
                <div>
                  <label className="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1 block">
                    Customer Name
                  </label>
                  <select
                    className="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500"
                    value={form.customer}
                    onChange={(e) => setForm({ ...form, customer: e.target.value })}
                  >
                    <option value="">Select Customer</option>
                    {demoCustomers.map((c) => (
                      <option key={c.id} value={c.name}>
                        {c.name}
                      </option>
                    ))}
                  </select>
                </div>

                <Input
                  label="Project Name"
                  value={form.project}
                  onChange={(v) => setForm({ ...form, project: v })}
                />

                <Input
                  label="ERP Reference ID"
                  value={form.erpID}
                  placeholder="e.g. ERP-9942"
                  onChange={(v) => setForm({ ...form, erpID: v })}
                />

                <div>
                  <label className="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1 block">
                    Service Type
                  </label>
                  <select
                    className="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500"
                    value={form.serviceCategory}
                    onChange={(e) => setForm({ ...form, serviceCategory: e.target.value })}
                  >
                    {serviceType.map((t) => (
                      <option key={t} value={t}>{t}</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label className="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1 block">
                    Service Status
                  </label>
                  <select
                    className="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500"
                    value={form.status}
                    onChange={(e) => setForm({ ...form, status: e.target.value })}
                  >
                    {serviceStatus.map((status) => (
                      <option key={status} value={status}>{status}</option>
                    ))}
                  </select>
                </div>

                {/* PLACED DIRECTLY BENEATH DATACENTER SELECTOR */}
                <div>
                  <label className="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1 block">
                    Activation Date
                  </label>
                  <input
                    type="date"
                    className="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white text-gray-900 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                    value={form.activationDate || ""}
                    onChange={(e) => setForm({ ...form, activationDate: e.target.value })}
                  />
                </div>

                <div>
                  <label className="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1 block">
                    Discontinue Date
                  </label>
                  <input
                    type="date"
                    className="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white text-gray-900 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                    value={form.discontinueDate || ""}
                    onChange={(e) => setForm({ ...form, discontinueDate: e.target.value })}
                  />
                </div>

                <div className="sm:col-span-2">
                  <Input
                    label="Discontinue Reason"
                    value={form.discontinueReason}
                    placeholder="Provide justification or background for infrastructure decommissioning..."
                    onChange={(v) => setForm({ ...form, discontinueReason: v })}
                  />
                </div>

                {/* DYNAMIC EXPIRY PROOF OF CONCEPT SELECTION */}
                {form.status === "POC" && (
                  <div className="sm:col-span-2 border border-indigo-100 rounded-xl p-4 bg-indigo-50/40 space-y-2 animate-fade-in">
                    <div className="text-xs font-bold text-indigo-800 uppercase tracking-wider flex items-center gap-1.5">
                      <Calendar size={14} /> POC Parameters Required
                    </div>
                    <div>
                      <label className="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1 block">
                        POC Expiration Deadline
                      </label>
                      <input
                        type="date"
                        className="w-full max-w-xs border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white text-gray-900 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                        value={form.pocExpiryDate || ""}
                        onChange={(e) => setForm({ ...form, pocExpiryDate: e.target.value })}
                      />
                    </div>
                  </div>
                )}

                {/* DYNAMIC TEMPORARILY DISABLED TIMELINE INPUT */}
                {form.status === "Temporarily disabled" && (
                  <div className="sm:col-span-2 border border-zinc-200 rounded-xl p-4 bg-zinc-50 space-y-2 animate-fade-in">
                    <div className="text-xs font-bold text-zinc-800 uppercase tracking-wider flex items-center gap-1.5">
                      <Calendar size={14} /> Disablement Timeline Matrix
                    </div>
                    <div>
                      <label className="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1 block">
                        Temporary Disabled Date
                      </label>
                      <input
                        type="date"
                        className="w-full max-w-xs border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white text-gray-900 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                        value={form.temporarilydisabledDate || ""}
                        onChange={(e) => setForm({ ...form, temporarilydisabledDate: e.target.value })}
                      />
                    </div>
                  </div>
                )}

              </div>

              {/* DYNAMIC METADATA FORM FIELDS BLOCK */}
              {renderDynamicFields()}
            </div>

            {/* MODAL CONFIG FOOTER */}
            <div className="border-t border-gray-100 p-4 bg-gray-50/50 flex items-center justify-end gap-2">
              <button
                onClick={() => setModalOpen(false)}
                className="h-9 px-4 border border-gray-200 hover:bg-gray-100 active:bg-gray-200 rounded-lg text-sm font-medium text-gray-600 transition-colors"
              >
                Cancel
              </button>
              <button
                onClick={saveService}
                className="h-9 px-4 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 rounded-lg text-sm font-medium text-white shadow-sm transition-colors"
              >
                Apply System Changes
              </button>
            </div>

          </div>
        </div>
      )}
      
      {/* INJECTED GLOBAL PRINTSHEET STYLING FOR PDF WRAPS */}
      <style dangerouslySetInnerHTML={{__html: `
        @media print {
          body { background: white; color: black; }
          .print\\:hidden { display: none !important; }
          .print\\:block { display: block !important; }
          table { width: 100% !important; border: 1px solid #E5E7EB !important; border-collapse: collapse !important; }
          th, td { border: 1px solid #E5E7EB !important; padding: 8px !important; }
        }
      `}} />
    </div>
  );
}

/**
 * =========================================================
 * INPUT COMPONENT
 * =========================================================
 */
function Input({ label, value, onChange, placeholder }) {
  return (
    <div>
      <label className="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1 block">
        {label}
      </label>
      <input
        className="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white text-gray-900 placeholder-gray-300 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
        placeholder={placeholder || `Enter ${label.toLowerCase()}...`}
        value={value || ""}
        onChange={(e) => onChange(e.target.value)}
      />
    </div>
  );
}