    if (editing) {
      setServices((prev) =>
        prev.map((s) => (s.id === editing.id ? { ...finalForm, id: editing.id } : s))
      );
    } else {
      setServices((prev) => [...prev, { ...finalForm, id: Date.now() }]);
    }
    setModalOpen(false);
