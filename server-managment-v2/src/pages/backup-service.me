    const headers = ["Customer", "ERP ID", "Project", "Service Type", "Status", "Activation Date", "Discontinue Date", "Discontinue Reason", "Primary IP", "Primary VLAN", "Secondary IP", "Secondary VLAN", "Cluster", "Datacenter"];
    headers.forEach(h => htmlStr += `<th style="background-color:#F3F4F6;">${h}</th>`);
    htmlStr += `</tr></thead><tbody>`;
    
    filteredServices.forEach(s => {
      htmlStr += `<tr>
        <td>${s.customer || ""}</td>
        <td>${s.erpID || ""}</td>
        <td>${s.project || ""}</td>
        <td>${s.serviceCategory || ""}</td>
