    htmlStr += `</tbody></table>`;

    const dataType = 'application/vnd.ms-excel';
    const link = document.createElement("a");
    link.href = `data:${dataType}, ${encodeURIComponent(htmlStr)}`;
    link.download = `services_catalog_${Date.now()}.xls`;
