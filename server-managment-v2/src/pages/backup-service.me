  const exportToCSV = () => {
    const headers = ["Customer", "ERP ID", "Project", "Service Type", "Status", "Activation Date", "Discontinue Date", "Discontinue Reason", "Primary IP", "Primary VLAN", "Secondary IP", "Secondary VLAN", "Cluster", "Datacenter"];
    const rows = filteredServices.map(s => [
      s.customer || "",
      s.erpID || "",
      s.project || "",
      s.serviceCategory || "",
      s.status || "",
      s.activationDate || "",
      s.discontinueDate || "",
      s.discontinueReason || "",
      s.ip || "",
      s.primaryvlan || "",
      s.secondaryip || "",
      s.secondaryvlan || "",
      s.cluster || "",
      s.datacenter || ""
    ]);

    const csvContent = "data:text/csv;charset=utf-8," 
      + [headers.join(","), ...rows.map(e => e.map(val => `"${val}"`).join(","))].join("\n");
    
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", `services_catalog_${Date.now()}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    setExportDropdownOpen(false);
  };

  const exportToExcel = () => {
