/**
 * =========================================================
 * MAIN COMPONENT
 * =========================================================
 */
export default function ServiceManagement() {
  const [services, setServices] = useState([
    {
      id: 1,
      customer: "ABC Corp",
      project: "ERP System",
      erpID: "ERP-9942",
      serviceCategory: "VPS",
      status: "Active",
      datacenter: "CTG",
      cluster: "ROL Cluster",
      ip: "192.168.0.10",
      primaryvlan: "100",
      secondaryip: "10.0.0.15",
      secondaryvlan: "200",
      vram: "8 GB",
      vdisk: "100 GB",
      vpsid: "VPS-1001",
      comments: "Production database host.",
      pocExpiryDate: "",
      temporarilydisabledDate: "",
      activationDate: "2026-01-15",
      discontinueDate: "2026-05-20",
      discontinueReason: "Migration to dedicated cloud hardware stack."
    },
  ]);

  const [search, setSearch] = useState("");
  const [filterCategory, setFilterCategory] = useState("");
  const [filterStatus, setFilterStatus] = useState("");
  const [filterCluster, setFilterCluster] = useState("");
  const [filterDatacenter, setFilterDatacenter] = useState("");
  
  // Advanced Range State Engine
  const [filterStartDate, setFilterStartDate] = useState("");
  const [filterEndDate, setFilterEndDate] = useState("");
  
  const [exportDropdownOpen, setExportDropdownOpen] = useState(false);
  const [modalOpen, setModalOpen] = useState(false);
  const [editing, setEditing] = useState(null);

  const [form, setForm] = useState({
    customer: "",
    project: "",
    erpID: "",
    serviceCategory: "VPS",
    status: "Active",
    datacenter: "",
    cluster: "",
    clusterSearch: "",
    ip: "",
    domain: "",
    vram: "",
    vdisk: "",
    vpsid: "",
    vcpu: "",
    additionaldisk: "",
    primaryvlan: "",
    secondaryvlan: "",
    secondaryip: "",
    comments: "",
    pocExpiryDate: "",
    temporarilydisabledDate: "",
    activationDate: "",
    discontinueDate: "",
    discontinueReason: ""
  });

  const filteredClusters = virtualizationClusters.filter((cluster) =>
    cluster.toLowerCase().includes((form.clusterSearch || "").toLowerCase())
  );

  // Global Universal Search & Multi-Column Date Range Evaluator
  const filteredServices = useMemo(() => {
    return services.filter((s) => {
      const targetQuery = search.toLowerCase();
      const matchSearch =
        !search ||
        Object.values(s).some(value => 
          value && String(value).toLowerCase().includes(targetQuery)
        );

      const matchCategory = filterCategory ? s.serviceCategory === filterCategory : true;
      const matchStatus = filterStatus ? s.status === filterStatus : true;
      const matchCluster = filterCluster ? s.cluster === filterCluster : true;
      const matchDatacenter = filterDatacenter ? s.datacenter === filterDatacenter : true;

      // Evaluation Logic: Checks if EITHER milestone date sits between the specified filter bounds
      let matchDateRange = true;
      if (filterStartDate || filterEndDate) {
        const start = filterStartDate ? new Date(filterStartDate) : null;
        const end = filterEndDate ? new Date(filterEndDate) : null;
        
        const actDate = s.activationDate ? new Date(s.activationDate) : null;
        const discDate = s.discontinueDate ? new Date(s.discontinueDate) : null;

        const isActInRange = actDate && (!start || actDate >= start) && (!end || actDate <= end);
        const isDiscInRange = discDate && (!start || discDate >= start) && (!end || discDate <= end);

        matchDateRange = isActInRange || isDiscInRange;
      }

      return matchSearch && matchCategory && matchStatus && matchCluster && matchDatacenter && matchDateRange;
    });
  }, [services, search, filterCategory, filterStatus, filterCluster, filterDatacenter, filterStartDate, filterEndDate]);

  const [page, setPage] = useState(1);
  const perPage = 5;

  const paginated = filteredServices.slice(
    (page - 1) * perPage,
    page * perPage
  );

  const totalPages = Math.ceil(filteredServices.length / perPage) || 1;

  const openAdd = () => {
    setEditing(null);
    setForm({
      customer: "",
      project: "",
      erpID: "",
      serviceCategory: "VPS",
      status: "Active",
      datacenter: "",
      cluster: "",
      clusterSearch: "",
      ip: "",
      domain: "",
      vram: "",
      vdisk: "",
      vpsid: "",
      vcpu: "",
      additionaldisk: "",
      primaryvlan: "",
      secondaryvlan: "",
      secondaryip: "",
      comments: "",
      pocExpiryDate: "",
      temporarilydisabledDate: "",
      activationDate: "",
      discontinueDate: "",
      discontinueReason: ""
    });
    setModalOpen(true);
  };

  const openEdit = (item) => {
    setEditing(item);
    setForm({ ...item, clusterSearch: "" });
    setModalOpen(true);
  };

  const saveService = () => {
    const finalForm = {
